# SCENTIQ Application Environment Variables

# Environment Mode: development, test, staging, production
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application Metadata
PROJECT_NAME="SCENTIQ"
API_V1_STR="/api/v1"

# CORS (Frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 16)
# Local development can also use SQLite for lightweight testing without Docker: sqlite:///./scentiq_dev.db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scentiq
POSTGRES_PASSWORD=scentiq_dev_secret
POSTGRES_DB=scentiq
DATABASE_URL=postgresql+psycopg2://scentiq:scentiq_dev_secret@localhost:5432/scentiq

# Test Database
TEST_DATABASE_URL=sqlite:///:memory:

# Security & Authentication (Replace in staging/production)
SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars_scentiq2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Context & Currency
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# AI Advisor Configuration (EPIC-11 - Kept disabled/mocked in foundation)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Public Web Application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
PORT=3000

